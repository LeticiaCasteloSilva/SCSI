# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (nativo, Postgres.app)
DATABASE_URL=

# Celery: RabbitMQ como broker, Redis como result backend
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Cache da aplicacao
REDIS_CACHE_URL=

# Localizacao
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# E-mail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nao-responda@scsi.local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini
AI_MAX_TOOL_CALLS=8
AI_TIMEOUT_SECONDS=120

# Media protegida
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=20

# Inicializacao
WAIT_FOR_DB_TIMEOUT=60
